# Copier ce fichier en ".env" et adapter si besoin.
# .env n'est JAMAIS commite (il est dans .gitignore) : c'est la regle de base
# pour ne pas publier de mot de passe sur GitHub.
DB_USER=tvfed
DB_PASSWORD=tvfed
DB_NAME=tvfed
DB_HOST=localhost
DB_PORT=5432

# Verification des certificats HTTPS. NE PASSER A false QUE pour diagnostiquer
# un blocage SSL, et remettre true ensuite.
SSL_VERIFY=true
