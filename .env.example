# Copier ce fichier en ".env" puis choisir un mot de passe.
# Le .env n'est JAMAIS commite (il est dans .gitignore).
#
# Aucune valeur de mot de passe ne figure dans ce depot : un identifiant en
# clair dans un fichier versionne est detecte comme fuite de secret (c'est le
# role de GitGuardian) et reste ensuite dans l'historique git pour toujours.
DB_USER=tvfed
DB_PASSWORD=
DB_NAME=tvfed
DB_HOST=localhost
DB_PORT=5432

# Verification des certificats HTTPS. NE PASSER A false QUE pour diagnostiquer
# un blocage SSL, et remettre true ensuite.
SSL_VERIFY=true
